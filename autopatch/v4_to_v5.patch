+def default_output_path(src: Path) -> Path:
+    if src.suffix:
+        return src.with_name(f"{src.stem}.patched{src.suffix}")
+    return src.with_name(src.name + ".patched")
+
+
+def apply_patch_plans(image: ElfImage, plans: list[dict], output: Path) -> tuple[str, str]:
+    if output.resolve() == image.path.resolve():
+        raise PatchError("refusing to patch the source ELF in place")
+    if output.exists():
+        raise PatchError(f"output already exists: {output}")
+
+    by_offset = {}
+    for plan in plans:
+        off = int(plan["instruction_file_offset"])
+        original = int(plan["original_word"], 16)
+        replacement = int(plan["replacement_word"], 16)
+        prior = by_offset.get(off)
+        if prior is not None and prior != replacement:
+            raise PatchError(
+                f"conflicting replacements at file offset 0x{off:X}: "
+                f"0x{prior:08X} vs 0x{replacement:08X}"
+            )
+        by_offset[off] = replacement
+        actual = word_at(image.data, off)
+        if actual != original:
+            raise PatchError(
+                f"original-word verification failed at 0x{off:X}: "
+                f"expected 0x{original:08X}, got "
+                f"{None if actual is None else f'0x{actual:08X}'}"
+            )
+
+    patched = bytearray(image.data)
+    for off, replacement in sorted(by_offset.items()):
+        patched[off:off + 4] = replacement.to_bytes(4, "little")
+
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_bytes(patched)
+    try:
+        output.chmod(image.path.stat().st_mode & 0o777)
+    except OSError:
+        pass
+
+    verify = output.read_bytes()
+    for off, replacement in sorted(by_offset.items()):
+        actual = word_at(verify, off)
+        if actual != replacement:
+            raise PatchError(
+                f"post-write verification failed at 0x{off:X}: "
+                f"expected 0x{replacement:08X}, got "
+                f"{None if actual is None else f'0x{actual:08X}'}"
+            )
+
+    return sha256_bytes(image.data), sha256_bytes(verify)
+
